DATABASE_URL=postgresql+psycopg2://cancelfill:cancelfill@localhost:5433/cancelfill
DEFAULT_HOLD_DURATION_SECONDS=900
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Public URL of the frontend (used in password-reset links) ---
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Notifications (each channel just logs to the console until configured) ---
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CancelFill <no-reply@cancelfill.local>
SMTP_USE_TLS=true
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Web Push (generate keys with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cancelfill.local

# --- Payments: none | mock | razorpay ---
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=INR
PAYMENT_WINDOW_SECONDS=600
REFUND_CUTOFF_HOURS=24
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=mock-payment-secret
